# Должен совпадать с именем этого файла: по нему compose понимает,
# что пробрасывать внутрь контейнеров
ENV_FILE=.env.local # прод .env.production

# Публичный адрес сайта. Идёт в ссылки писем и в returnUrl ЮKassa.
APP_URL=http://localhost:3000 # прод https://pixora-ai.ru

# Куда Next проксирует /api/*. В докере переопределяется в compose.
API_INTERNAL_URL=http://localhost:3001 # в проде оставить как есть

# Куда пишутся вариации логотипов. В докере это volume. Оставляем пустым.
GENERATED_LOGOS_DIR=

# Шрифты брендбука: откуда читать ttf для метрик и для архива покупателю.
# Пусто = public/fonts рядом с кодом, в образе это /app/public/fonts.
FONTS_DIR=

# Чем собирать PDF брендбука. Пусто = rsvg-convert из PATH (пакет librsvg2-bin
# стоит в образе). Задавать только если бинарник лежит в необычном месте.
RSVG_CONVERT_BIN=

POSTGRES_USER=pixora 
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pixora
POSTGRES_PORT=5432

# Внутри докера хост — имя сервиса db, снаружи — localhost
DATABASE_URL=postgresql://pixora:change-me@db:5432/pixora

# Обязательно свой: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Почта — Яндекс Cloud Postbox
POSTBOX_SMTP_HOST=postbox.cloud.yandex.net
POSTBOX_SMTP_PORT=587
POSTBOX_SMTP_USER=
POSTBOX_SMTP_PASSWORD=

# Домен отправителя должен быть подтверждён в Postbox
MAIL_FROM="Pixora <noreply@pixora-ai.ru>"

# Куда падают письма из формы обратной связи
CONTACT_EMAIL=arttaranovbusiness@gmail.com

GENAPI_KEY=

# Защита от фарма бесплатных генераций. Пусто = значения по умолчанию.
# Генераций в сутки с одного адреса (IPv6 считается подсетью /64).
# На пользователей, которые уже платили, не действует
IP_DAILY_LOGO_LIMIT=10
IP_DAILY_NAME_LIMIT=10
# Потолок трат на бесплатные генерации за сутки по Москве, рубли (по смете).
# При превышении бесплатное на паузе до полуночи, оплаченные заказы идут как обычно
GENAPI_DAILY_BUDGET_RUB=500
# Сколько логотипов генерируется одновременно и сколько ждёт в очереди
LOGO_CONCURRENCY=4
LOGO_QUEUE=20

# Через сколько дней удалять неоплаченные логотипы. Пусто = 90, 0 = не удалять.
# Срок записан в политике конфиденциальности — меняя его, правьте и её текст
UNPAID_LOGO_RETENTION_DAYS=90

# Уровень логов бэкенда: debug, info, warn, error. Пусто = info
LOG_LEVEL=

# Куда слать алерты о сбоях с оплаченными заказами и бюджетом.
# Пусто = на CONTACT_EMAIL
ALERT_EMAIL=

# Кто может открыть /admin: адреса аккаунтов через запятую. Пусто = админка закрыта для всех.
# Аккаунт должен быть обычным зарегистрированным пользователем с подтверждённой почтой
ADMIN_EMAILS=

# Магазин из личного кабинета ЮKassa. Подписи у вебхука нет, секрета тут не бывает.
# Уведомления настраиваются там же, в кабинете - по шагам в docs/run.md
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Только для прода: домен под сертификат и почта для Let's Encrypt
DOMAIN=
ACME_EMAIL=arttaranovbusiness@gmail.com