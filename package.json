{
  "name": "pixorasaas",
  "version": "1.0.0",
  "description": "Современное веб-приложение для генерации полного брендинга с использованием искусственного интеллекта.",
  "main": "index.ts",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "server": "ts-node-dev --project backend/tsconfig.json backend/index.ts",
    "db:migrate": "ts-node --project backend/tsconfig.json backend/db/migrate.ts",
    "docker:dev": "docker compose --env-file .env.local --profile dev up --build",
    "docker:prod": "docker compose --env-file .env.production --profile prod up -d --build",
    "typecheck": "tsc --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.131",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify/utils": "^3.1.7",
    "archiver": "^7.0.1",
    "argon2": "^0.41.1",
    "axios": "^1.10.0",
    "colord": "^2.9.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.2.1",
    "nodemailer": "^10.0.15",
    "opentype.js": "^2.0.0",
    "pg": "^8.13.1",
    "pino": "^10.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "uuid": "^11.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/archiver": "^6.0.3",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.19.4",
    "@types/nodemailer": "^6.4.17",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rufkndev/pixorasaas.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rufkndev/pixorasaas/issues"
  },
  "homepage": "https://github.com/rufkndev/pixorasaas#readme"
}
